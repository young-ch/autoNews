# ==============================================================================
# [1] AI LLM 설정 (Gemini 또는 OpenAI)
# ==============================================================================
# 사용하려는 LLM 공급자: 'gemini' (기본값) 또는 'openai'
LLM_PROVIDER=gemini

# Google Gemini API 키 (https://aistudio.google.com/ 에서 무료 발급 가능)
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-1.5-flash

# OpenAI API 키 (선택 사항: LLM_PROVIDER=openai 설정 시 사용)
OPENAI_API_KEY=your_openai_api_key_here
OPENAI_MODEL=gpt-4o-mini

# ==============================================================================
# [2] 블로그 자동 발행 설정 (워드프레스 또는 티스토리)
# ==============================================================================
# 대상 블로그 플랫폼: 'wordpress' (기본값) 또는 'tistory'
BLOG_PLATFORM=wordpress

# --- [워드프레스 설정] ---
# 워드프레스 사이트 주소 (끝에 / 없이 입력, 예: https://myblog.com)
WORDPRESS_URL=https://your-wordpress-site.com

# 워드프레스 관리자 계정 아이디
WORDPRESS_USER=your_wordpress_username

# 워드프레스 '애플리케이션 비밀번호' (Application Password)
# [주의] 일반 웹사이트 로그인 비밀번호가 아닙니다!
# 발급 방법: 워드프레스 관리자 대시보드 -> 사용자(Users) -> 프로필(Profile) -> 
#            하단의 '애플리케이션 비밀번호' 항목에서 이름 입력 후 '새 애플리케이션 비밀번호 추가' 클릭
# 생성된 24자리 문자열(예: abcd efgh ijkl mnop qrst uvwx)을 그대로 붙여넣으세요.
WORDPRESS_APP_PASSWORD=xxxx xxxx xxxx xxxx xxxx xxxx

# (선택) 포스팅을 저장할 워드프레스 카테고리 ID (기본값: 비워두면 미분류)
WORDPRESS_CATEGORY_ID=

# (선택) 발행 상태: 'draft' (임시저장 - 검토 후 발행) 또는 'publish' (즉시 전체 공개 발행)
WORDPRESS_POST_STATUS=draft

# --- [티스토리 설정 (선택 사항: BLOG_PLATFORM=tistory 설정 시)] ---
# 티스토리 오픈 API Access Token
TISTORY_ACCESS_TOKEN=
# 티스토리 블로그 이름 (예: myblog.tistory.com 인 경우 'myblog')
TISTORY_BLOG_NAME=

# ==============================================================================
# [3] 데이터 수집 옵션
# ==============================================================================
# 키워드별 수집할 최대 기사 수 (기본: 3)
MAX_ARTICLES_PER_KEYWORD=3
