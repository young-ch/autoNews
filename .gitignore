# ==============================================================================
# 보안 및 민감 정보 보호 (.gitignore)
# ==============================================================================
# [중요] API 키와 비밀번호가 포함된 .env 파일은 GitHub에 절대 올리지 않습니다.
.env

# 파이썬 캐시 파일
__pycache__/
*.py[cod]
*$py.class

# 가상환경
venv/
.venv/
env/

# 일별 실행 로그 및 생성된 임시 파일
logs/
last_generated_report.html
last_market_close_report.html

# 생성된 차트 이미지 (서버에서 자동 생성됨)
charts/

# 도커 데이터 볼륨 (서버 배포 시 생성됨)
wp_data/
db_data/
